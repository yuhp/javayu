---
import type { CollectionEntry } from 'astro:content';
import { copy, dateForLocale, type Language } from '../lib/site';

interface Props {
  lang: Language;
  posts: CollectionEntry<'posts'>[];
  showFeatureCover?: boolean;
}

const { lang, posts, showFeatureCover = false } = Astro.props;
const text = copy[lang];
---

{posts.length ? (
  <ol class="post-list">
    {posts.map((post, index) => {
      const slug = post.id.split('/').at(-1);
      return (
        <li>
          <article class:list={['post-list__item', { 'post-list__item--featured': showFeatureCover && index === 0 && post.data.cover }]}>
            <div class="post-list__content">
              <div class="post-list__meta">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {dateForLocale(post.data.publishedAt, lang)}
                </time>
                {post.data.tags.length > 0 && <span>{post.data.tags.join(' / ')}</span>}
              </div>
              <h2><a href={`/${lang}/posts/${slug}/`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <a class="text-link" href={`/${lang}/posts/${slug}/`}>{text.readArticle} <span aria-hidden="true">&rarr;</span></a>
            </div>
            {showFeatureCover && index === 0 && post.data.cover && (
              <a class="post-list__cover" href={`/${lang}/posts/${slug}/`} aria-label={post.data.title}>
                <img src={post.data.cover.thumbnail ?? post.data.cover.src} alt="" width="168" height="95" />
              </a>
            )}
          </article>
        </li>
      );
    })}
  </ol>
) : <p class="empty-state">{text.noPosts}</p>}
